// Prisma Schema - Law Firm Management Software
// SQLite-compatible (no native enums — use String fields with validation in app layer)
// Run: npx prisma db push && npx prisma generate && npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH & USERS
// UserRole values: SUPER_ADMIN | SENIOR_ADVOCATE | ADVOCATE | JUNIOR_ADVOCATE
//                  ASSOCIATE | CLERK | TYPIST | ACCOUNTANT | RECEPTIONIST
//                  OFFICE_MANAGER | IT_ADMIN | CLIENT
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  password       String
  role           String    @default("CLIENT")
  avatar         String?
  phone          String?
  isActive       Boolean   @default(true)
  twoFAEnabled   Boolean   @default(false)
  twoFASecret    String?
  lastLoginAt    DateTime?
  mustChangePassword Boolean @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee       Employee?
  client         Client?
  sessions       Session[]
  auditLogs      AuditLog[]
  assignedTasks  Task[]    @relation("TaskAssignee")
  createdTasks   Task[]    @relation("TaskCreator")
  notifications  Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthThrottle {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entity     String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// EMPLOYEES & ADVOCATES
// ─────────────────────────────────────────────

model Employee {
  id               String    @id @default(cuid())
  employeeId       String    @unique
  userId           String    @unique
  department       String?
  designation      String?
  barCouncilNo     String?
  joiningDate      DateTime?
  salary           Float?
  bankAccount      String?
  ifscCode         String?
  panNumber        String?
  aadharNumber     String?
  address          String?
  emergencyContact String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                  User               @relation(fields: [userId], references: [id])
  attendances           Attendance[]
  leaves                Leave[]
  salarySlips           SalarySlip[]
  assignedCasesAsSenior Case[]             @relation("SeniorAdvocate")
  assignedCasesAsJunior Case[]             @relation("JuniorAdvocate")
  assignedCasesAsClerk  Case[]             @relation("CaseClerk")
  documents             EmployeeDocument[]
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("PRESENT")
  notes       String?
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model Leave {
  id          String    @id @default(cuid())
  employeeId  String
  leaveType   String
  fromDate    DateTime
  toDate      DateTime
  reason      String?
  status      String    @default("PENDING")
  approvedBy  String?
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model SalarySlip {
  id          String    @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Float
  allowances  Float     @default(0)
  incentives  Float     @default(0)
  deductions  Float     @default(0)
  netSalary   Float
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model EmployeeDocument {
  id          String    @id @default(cuid())
  employeeId  String
  name        String
  type        String
  url         String
  uploadedAt  DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

// ─────────────────────────────────────────────
// CLIENTS
// clientType: INDIVIDUAL | CORPORATE | NRI
// ─────────────────────────────────────────────

model Client {
  id               String    @id @default(cuid())
  clientId         String    @unique
  userId           String?   @unique
  name             String
  fatherName       String?
  mobile           String
  altMobile        String?
  email            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  clientType       String    @default("INDIVIDUAL")
  occupation       String?
  companyName      String?
  idType           String?
  idNumber         String?
  referenceSource  String?
  referredBy       String?
  assignedAdvocate String?
  assignedClerk    String?
  notes            String?
  isActive         Boolean   @default(true)
  whatsappOptIn    Boolean   @default(false)
  smsOptIn         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  cases          Case[]
  leads          Lead[]
  invoices       Invoice[]
  payments       Payment[]
  communications Communication[]
  documents      Document[]
  appointments   Appointment[]
}

model Communication {
  id          String    @id @default(cuid())
  clientId    String
  type        String
  subject     String?
  message     String
  sentAt      DateTime  @default(now())
  sentBy      String?
  client      Client    @relation(fields: [clientId], references: [id])
}

// ─────────────────────────────────────────────
// LEADS
// status: NEW | CONTACTED | CONSULTATION | CONVERTED | LOST
// ─────────────────────────────────────────────

model Lead {
  id               String    @id @default(cuid())
  name             String
  mobile           String
  email            String?
  source           String?
  practiceArea     String?
  description      String?
  status           String    @default("NEW")
  assignedTo       String?
  consultationDate DateTime?
  estimatedFee     Float?
  conversionDate   DateTime?
  notes            String?
  clientId         String?
  followUpDate     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─────────────────────────────────────────────
// CASES
// caseType: CRIMINAL|CIVIL|FAMILY|PROPERTY|CHEQUE_BOUNCE|BAIL|
//           CORPORATE|CONSUMER|LABOUR|BANKING|CYBER_CRIME|CONSTITUTIONAL|OTHER
// court: SUPREME_COURT|HIGH_COURT|DISTRICT_COURT|SESSIONS_COURT|
//        MAGISTRATE_COURT|FAMILY_COURT|CONSUMER_COURT|LABOUR_COURT|TRIBUNAL|OTHER
// status: ACTIVE|CLOSED|DISPOSED|STAYED|TRANSFERRED|WITHDRAWN|APPEALED
// ─────────────────────────────────────────────

model Case {
  id               String    @id @default(cuid())
  caseId           String    @unique
  caseNumber       String?
  cnrNumber        String?   @unique
  title            String
  caseType         String
  court            String
  bench            String?
  judge            String?
  filingDate       DateTime?
  registrationDate DateTime?
  stage            String?
  status           String    @default("ACTIVE")
  priority         String    @default("NORMAL")

  clientId         String
  oppositeParty    String?
  oppositeAdvocate String?
  actsAndSections  String?

  seniorAdvocateId String?
  juniorAdvocateId String?
  clerkId          String?

  description      String?
  notes            String?
  limitationDate   DateTime?
  nextHearingDate  DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client         Client        @relation(fields: [clientId], references: [id])
  seniorAdvocate Employee?     @relation("SeniorAdvocate", fields: [seniorAdvocateId], references: [id])
  juniorAdvocate Employee?     @relation("JuniorAdvocate", fields: [juniorAdvocateId], references: [id])
  clerk          Employee?     @relation("CaseClerk", fields: [clerkId], references: [id])
  hearings       Hearing[]
  documents      Document[]
  invoices       Invoice[]
  tasks          Task[]
  criminalDetail CriminalCase?
  civilDetail    CivilCase?
  caseHistory    CaseHistory[]
}

model CaseHistory {
  id          String    @id @default(cuid())
  caseId      String
  event       String
  description String
  date        DateTime
  addedBy     String?
  createdAt   DateTime  @default(now())
  case        Case      @relation(fields: [caseId], references: [id])
}

// ─────────────────────────────────────────────
// CRIMINAL CASE DETAILS
// ─────────────────────────────────────────────

model CriminalCase {
  id                 String    @id @default(cuid())
  caseId             String    @unique
  firNumber          String?
  firDate            DateTime?
  policeStation      String?
  sections           String?
  accusedName        String?
  accusedDetails     String?
  complainantName    String?
  complainantDetails String?
  isArrested         Boolean   @default(false)
  arrestDate         DateTime?
  custodyType        String?
  bailStatus         String?
  bailType           String?
  bailDate           DateTime?
  remandDate         DateTime?
  chargeSheetFiled   Boolean   @default(false)
  chargeSheetDate    DateTime?
  trialStage         String?
  witnesses          String?
  statements         String?
  bailApplication    String?
  revisionDetails    String?
  evidenceDetails    String?
  verdict            String?
  verdictDate        DateTime?
  sentence           String?
  appeal             Boolean   @default(false)
  appealCourt        String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id])
}

// ─────────────────────────────────────────────
// CIVIL CASE DETAILS
// ─────────────────────────────────────────────

model CivilCase {
  id                 String    @id @default(cuid())
  caseId             String    @unique
  suitType           String?
  plaintiffName      String?
  plaintiffDetails   String?
  defendantName      String?
  defendantDetails   String?
  plaint             String?
  writtenStatement   String?
  replication        String?
  issues             String?
  propertyDetails    String?
  agreementDetails   String?
  interimApplication String?
  injunctionStatus   String?
  executionStatus    String?
  decree             String?
  decreeDate         DateTime?
  appeal             Boolean   @default(false)
  appealDetails      String?
  revisionDetails    String?
  evidenceDetails    String?
  notices            String?
  orders             String?
  judgment           String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id])
}

// ─────────────────────────────────────────────
// HEARINGS
// status: SCHEDULED | COMPLETED | ADJOURNED | CANCELLED
// purpose: ARGUMENTS | EVIDENCE | ORDERS | JUDGMENT | BAIL | MISC
// ─────────────────────────────────────────────

model Hearing {
  id                String    @id @default(cuid())
  caseId            String
  hearingDate       DateTime
  hearingTime       String?
  court             String?
  courtroom         String?
  judge             String?
  purpose           String?
  advocateId        String?
  status            String    @default("SCHEDULED")
  outcome           String?
  nextDate          DateTime?
  adjournmentReason String?
  notes             String?
  remindersSet      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  case      Case       @relation(fields: [caseId], references: [id])
  reminders Reminder[]
}

model Reminder {
  id          String    @id @default(cuid())
  hearingId   String?
  caseId      String?
  type        String
  message     String
  sendAt      DateTime
  isSent      Boolean   @default(false)
  deliveryStatus String @default("QUEUED")
  providerMessageId String?
  lastError String?
  sentAt      DateTime?
  recipientId String?
  createdAt   DateTime  @default(now())

  hearing Hearing? @relation(fields: [hearingId], references: [id])
}

// ─────────────────────────────────────────────
// DOCUMENTS
// category: FIR | CHARGE_SHEET | PLAINT | WRITTEN_STATEMENT | VAKALATNAMA
//           AFFIDAVIT | EVIDENCE | COURT_ORDER | JUDGMENT | NOTICE
//           AGREEMENT | IDENTITY_DOCUMENT | PROPERTY_DOCUMENT | PHOTO | OTHER
// ─────────────────────────────────────────────

model Document {
  id          String    @id @default(cuid())
  caseId      String?
  clientId    String?
  name        String
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  category    String    @default("OTHER")
  folder      String?
  description String?
  uploadedBy  String?
  version     Int       @default(1)
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case     Case?             @relation(fields: [caseId], references: [id])
  client   Client?           @relation(fields: [clientId], references: [id])
  versions DocumentVersion[]
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  fileUrl    String
  uploadedBy String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
}

// ─────────────────────────────────────────────
// BILLING & PAYMENTS
// feeType: CONSULTATION|CASE_FEE|APPEARANCE|DRAFTING|FILING|
//          DOCUMENTATION|COURT_EXPENSES|TRAVEL|MISCELLANEOUS
// invoice status: PENDING | PARTIAL | PAID | OVERDUE | CANCELLED
// payment method: CASH | UPI | BANK_TRANSFER | CHEQUE | ONLINE
// ─────────────────────────────────────────────

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  clientId      String
  caseId        String?
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  totalAmount   Float
  paidAmount    Float     @default(0)
  pendingAmount Float
  gstAmount     Float     @default(0)
  creditAmount  Float     @default(0)
  status        String    @default("PENDING")
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client   Client        @relation(fields: [clientId], references: [id])
  case     Case?         @relation(fields: [caseId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
  paymentOrders PaymentOrder[]
}

model PaymentOrder {
  id String @id
  invoiceId String
  amount Int
  currency String @default("INR")
  status String @default("CREATED")
  paymentId String? @unique
  createdAt DateTime @default(now())
  invoice Invoice @relation(fields:[invoiceId],references:[id])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  feeType     String
  description String
  quantity    Float   @default(1)
  rate        Float
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id            String    @id @default(cuid())
  paymentId     String    @unique
  clientId      String
  invoiceId     String?
  amount        Float
  paymentDate   DateTime  @default(now())
  paymentMethod String
  transactionId String?
  receiptNumber String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime  @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
}

// ─────────────────────────────────────────────
// APPOINTMENTS
// type: ONLINE | OFFLINE | PHONE
// status: PENDING | CONFIRMED | CANCELLED | COMPLETED
// ─────────────────────────────────────────────

model Appointment {
  id              String    @id @default(cuid())
  clientId        String?
  name            String
  mobile          String
  email           String?
  advocateId      String?
  appointmentDate DateTime
  slot            String?
  type            String    @default("OFFLINE")
  purpose         String?
  status          String    @default("PENDING")
  fee             Float?
  paymentStatus   String?
  notes           String?
  meetLink        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─────────────────────────────────────────────
// TASKS
// priority: LOW | NORMAL | HIGH | URGENT
// status: PENDING | IN_PROGRESS | COMPLETED | OVERDUE
// ─────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  caseId      String?
  assigneeId  String?
  creatorId   String?
  priority    String    @default("NORMAL")
  status      String    @default("PENDING")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case     Case? @relation(fields: [caseId], references: [id])
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User? @relation("TaskCreator", fields: [creatorId], references: [id])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// type: INFO | WARNING | SUCCESS | ERROR
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// COURT HOLIDAYS
// type: NATIONAL | STATE | COURT_SPECIFIC
// ─────────────────────────────────────────────

model CourtHoliday {
  id        String   @id @default(cuid())
  date      DateTime
  name      String
  court     String?
  type      String   @default("NATIONAL")
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// NEWS / LEGAL UPDATES
// category: NEWS | LEGAL_UPDATE | ANNOUNCEMENT
// ─────────────────────────────────────────────

model NewsUpdate {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  imageUrl    String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  authorId    String?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// TESTIMONIALS
// ─────────────────────────────────────────────

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  designation String?
  content     String
  rating      Int      @default(5)
  imageUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FirmSetting {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}

model Expense {
  id String @id @default(cuid())
  description String
  category String
  amount Float
  date DateTime @default(now())
  caseId String?
  recordedBy String?
  createdAt DateTime @default(now())
}
