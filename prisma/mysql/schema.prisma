// Generated by scripts/database-schema.cjs from prisma/schema.prisma.
// Change models in the source schema and add a MySQL migration for deployment.
// Prisma Schema - Law Firm Management Software
// SQLite-compatible (no native enums — use String fields with validation in app layer)
// Run: npx prisma db push && npx prisma generate && npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH & USERS
// UserRole values: SUPER_ADMIN | SENIOR_ADVOCATE | ADVOCATE | JUNIOR_ADVOCATE
//                  ASSOCIATE | CLERK | TYPIST | ACCOUNTANT | RECEPTIONIST
//                  OFFICE_MANAGER | IT_ADMIN | CLIENT
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid()) @db.VarChar(191)
  name           String @db.LongText
  email          String    @unique @db.VarChar(254)
  emailVerified  DateTime?
  password       String @db.LongText
  role           String    @default("CLIENT") @db.VarChar(191)
  avatar         String? @db.LongText
  phone          String? @db.LongText
  isActive       Boolean   @default(true)
  twoFAEnabled   Boolean   @default(false)
  twoFASecret    String? @db.LongText
  lastLoginAt    DateTime?
  mustChangePassword Boolean @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee       Employee?
  client         Client?
  sessions       Session[]
  auditLogs      AuditLog[]
  assignedTasks  Task[]    @relation("TaskAssignee")
  createdTasks   Task[]    @relation("TaskCreator")
  notifications  Notification[]
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String @db.VarChar(191)
  token     String   @unique @db.VarChar(191)
  expiresAt DateTime
  ipAddress String? @db.LongText
  userAgent String? @db.LongText
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthThrottle {
  key String @id @db.VarChar(191)
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(191)
  userId     String @db.VarChar(191)
  action     String @db.LongText
  entity     String @db.LongText
  entityId   String? @db.LongText
  details    String? @db.LongText
  ipAddress  String? @db.LongText
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// EMPLOYEES & ADVOCATES
// ─────────────────────────────────────────────

model Employee {
  id               String    @id @default(cuid()) @db.VarChar(191)
  employeeId       String    @unique @db.VarChar(191)
  userId           String    @unique @db.VarChar(191)
  department       String? @db.LongText
  designation      String? @db.LongText
  barCouncilNo     String? @db.LongText
  joiningDate      DateTime?
  salary           Float?
  bankAccount      String? @db.LongText
  ifscCode         String? @db.LongText
  panNumber        String? @db.LongText
  aadharNumber     String? @db.LongText
  address          String? @db.LongText
  emergencyContact String? @db.LongText
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                  User               @relation(fields: [userId], references: [id])
  attendances           Attendance[]
  leaves                Leave[]
  salarySlips           SalarySlip[]
  assignedCasesAsSenior Case[]             @relation("SeniorAdvocate")
  assignedCasesAsJunior Case[]             @relation("JuniorAdvocate")
  assignedCasesAsClerk  Case[]             @relation("CaseClerk")
  documents             EmployeeDocument[]
}

model Attendance {
  id          String    @id @default(cuid()) @db.VarChar(191)
  employeeId  String @db.VarChar(191)
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("PRESENT") @db.VarChar(191)
  notes       String? @db.LongText
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model Leave {
  id          String    @id @default(cuid()) @db.VarChar(191)
  employeeId  String @db.VarChar(191)
  leaveType   String @db.LongText
  fromDate    DateTime
  toDate      DateTime
  reason      String? @db.LongText
  status      String    @default("PENDING") @db.VarChar(191)
  approvedBy  String? @db.LongText
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model SalarySlip {
  id          String    @id @default(cuid()) @db.VarChar(191)
  employeeId  String @db.VarChar(191)
  month       Int
  year        Int
  basicSalary Float
  allowances  Float     @default(0)
  incentives  Float     @default(0)
  deductions  Float     @default(0)
  netSalary   Float
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model EmployeeDocument {
  id          String    @id @default(cuid()) @db.VarChar(191)
  employeeId  String @db.VarChar(191)
  name        String @db.LongText
  type        String @db.LongText
  url         String @db.LongText
  uploadedAt  DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

// ─────────────────────────────────────────────
// CLIENTS
// clientType: INDIVIDUAL | CORPORATE | NRI
// ─────────────────────────────────────────────

model Client {
  id               String    @id @default(cuid()) @db.VarChar(191)
  clientId         String    @unique @db.VarChar(191)
  userId           String?   @unique @db.VarChar(191)
  name             String @db.LongText
  fatherName       String? @db.LongText
  mobile           String @db.LongText
  altMobile        String? @db.LongText
  email            String? @db.LongText
  address          String? @db.LongText
  city             String? @db.LongText
  state            String? @db.LongText
  pincode          String? @db.LongText
  clientType       String    @default("INDIVIDUAL") @db.VarChar(191)
  occupation       String? @db.LongText
  companyName      String? @db.LongText
  idType           String? @db.LongText
  idNumber         String? @db.LongText
  referenceSource  String? @db.LongText
  referredBy       String? @db.LongText
  assignedAdvocate String? @db.LongText
  assignedClerk    String? @db.LongText
  notes            String? @db.LongText
  isActive         Boolean   @default(true)
  whatsappOptIn    Boolean   @default(false)
  smsOptIn         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  cases          Case[]
  leads          Lead[]
  invoices       Invoice[]
  payments       Payment[]
  communications Communication[]
  documents      Document[]
  appointments   Appointment[]
}

model Communication {
  id          String    @id @default(cuid()) @db.VarChar(191)
  clientId    String @db.VarChar(191)
  type        String @db.LongText
  subject     String? @db.LongText
  message     String @db.LongText
  sentAt      DateTime  @default(now())
  sentBy      String? @db.LongText
  client      Client    @relation(fields: [clientId], references: [id])
}

// ─────────────────────────────────────────────
// LEADS
// status: NEW | CONTACTED | CONSULTATION | CONVERTED | LOST
// ─────────────────────────────────────────────

model Lead {
  id               String    @id @default(cuid()) @db.VarChar(191)
  name             String @db.LongText
  mobile           String @db.LongText
  email            String? @db.LongText
  source           String? @db.LongText
  practiceArea     String? @db.LongText
  description      String? @db.LongText
  status           String    @default("NEW") @db.VarChar(191)
  assignedTo       String? @db.LongText
  consultationDate DateTime?
  estimatedFee     Float?
  conversionDate   DateTime?
  notes            String? @db.LongText
  clientId         String? @db.VarChar(191)
  followUpDate     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─────────────────────────────────────────────
// CASES
// caseType: CRIMINAL|CIVIL|FAMILY|PROPERTY|CHEQUE_BOUNCE|BAIL|
//           CORPORATE|CONSUMER|LABOUR|BANKING|CYBER_CRIME|CONSTITUTIONAL|OTHER
// court: SUPREME_COURT|HIGH_COURT|DISTRICT_COURT|SESSIONS_COURT|
//        MAGISTRATE_COURT|FAMILY_COURT|CONSUMER_COURT|LABOUR_COURT|TRIBUNAL|OTHER
// status: ACTIVE|CLOSED|DISPOSED|STAYED|TRANSFERRED|WITHDRAWN|APPEALED
// ─────────────────────────────────────────────

model Case {
  id               String    @id @default(cuid()) @db.VarChar(191)
  caseId           String    @unique @db.VarChar(191)
  caseNumber       String? @db.LongText
  cnrNumber        String?   @unique @db.VarChar(191)
  title            String @db.LongText
  caseType         String @db.LongText
  court            String @db.LongText
  bench            String? @db.LongText
  judge            String? @db.LongText
  filingDate       DateTime?
  registrationDate DateTime?
  stage            String? @db.LongText
  status           String    @default("ACTIVE") @db.VarChar(191)
  priority         String    @default("NORMAL") @db.VarChar(191)

  clientId         String @db.VarChar(191)
  oppositeParty    String? @db.LongText
  oppositeAdvocate String? @db.LongText
  actsAndSections  String? @db.LongText

  seniorAdvocateId String? @db.VarChar(191)
  juniorAdvocateId String? @db.VarChar(191)
  clerkId          String? @db.VarChar(191)

  description      String? @db.LongText
  notes            String? @db.LongText
  limitationDate   DateTime?
  nextHearingDate  DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client         Client        @relation(fields: [clientId], references: [id])
  seniorAdvocate Employee?     @relation("SeniorAdvocate", fields: [seniorAdvocateId], references: [id])
  juniorAdvocate Employee?     @relation("JuniorAdvocate", fields: [juniorAdvocateId], references: [id])
  clerk          Employee?     @relation("CaseClerk", fields: [clerkId], references: [id])
  hearings       Hearing[]
  documents      Document[]
  invoices       Invoice[]
  tasks          Task[]
  criminalDetail CriminalCase?
  civilDetail    CivilCase?
  caseHistory    CaseHistory[]
}

model CaseHistory {
  id          String    @id @default(cuid()) @db.VarChar(191)
  caseId      String @db.VarChar(191)
  event       String @db.LongText
  description String @db.LongText
  date        DateTime
  addedBy     String? @db.LongText
  createdAt   DateTime  @default(now())
  case        Case      @relation(fields: [caseId], references: [id])
}

// ─────────────────────────────────────────────
// CRIMINAL CASE DETAILS
// ─────────────────────────────────────────────

model CriminalCase {
  id                 String    @id @default(cuid()) @db.VarChar(191)
  caseId             String    @unique @db.VarChar(191)
  firNumber          String? @db.LongText
  firDate            DateTime?
  policeStation      String? @db.LongText
  sections           String? @db.LongText
  accusedName        String? @db.LongText
  accusedDetails     String? @db.LongText
  complainantName    String? @db.LongText
  complainantDetails String? @db.LongText
  isArrested         Boolean   @default(false)
  arrestDate         DateTime?
  custodyType        String? @db.LongText
  bailStatus         String? @db.LongText
  bailType           String? @db.LongText
  bailDate           DateTime?
  remandDate         DateTime?
  chargeSheetFiled   Boolean   @default(false)
  chargeSheetDate    DateTime?
  trialStage         String? @db.LongText
  witnesses          String? @db.LongText
  statements         String? @db.LongText
  bailApplication    String? @db.LongText
  revisionDetails    String? @db.LongText
  evidenceDetails    String? @db.LongText
  verdict            String? @db.LongText
  verdictDate        DateTime?
  sentence           String? @db.LongText
  appeal             Boolean   @default(false)
  appealCourt        String? @db.LongText
  notes              String? @db.LongText
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id])
}

// ─────────────────────────────────────────────
// CIVIL CASE DETAILS
// ─────────────────────────────────────────────

model CivilCase {
  id                 String    @id @default(cuid()) @db.VarChar(191)
  caseId             String    @unique @db.VarChar(191)
  suitType           String? @db.LongText
  plaintiffName      String? @db.LongText
  plaintiffDetails   String? @db.LongText
  defendantName      String? @db.LongText
  defendantDetails   String? @db.LongText
  plaint             String? @db.LongText
  writtenStatement   String? @db.LongText
  replication        String? @db.LongText
  issues             String? @db.LongText
  propertyDetails    String? @db.LongText
  agreementDetails   String? @db.LongText
  interimApplication String? @db.LongText
  injunctionStatus   String? @db.LongText
  executionStatus    String? @db.LongText
  decree             String? @db.LongText
  decreeDate         DateTime?
  appeal             Boolean   @default(false)
  appealDetails      String? @db.LongText
  revisionDetails    String? @db.LongText
  evidenceDetails    String? @db.LongText
  notices            String? @db.LongText
  orders             String? @db.LongText
  judgment           String? @db.LongText
  notes              String? @db.LongText
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id])
}

// ─────────────────────────────────────────────
// HEARINGS
// status: SCHEDULED | COMPLETED | ADJOURNED | CANCELLED
// purpose: ARGUMENTS | EVIDENCE | ORDERS | JUDGMENT | BAIL | MISC
// ─────────────────────────────────────────────

model Hearing {
  id                String    @id @default(cuid()) @db.VarChar(191)
  caseId            String @db.VarChar(191)
  hearingDate       DateTime
  hearingTime       String? @db.LongText
  court             String? @db.LongText
  courtroom         String? @db.LongText
  judge             String? @db.LongText
  purpose           String? @db.LongText
  advocateId        String? @db.LongText
  status            String    @default("SCHEDULED") @db.VarChar(191)
  outcome           String? @db.LongText
  nextDate          DateTime?
  adjournmentReason String? @db.LongText
  notes             String? @db.LongText
  remindersSet      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  case      Case       @relation(fields: [caseId], references: [id])
  reminders Reminder[]
}

model Reminder {
  id          String    @id @default(cuid()) @db.VarChar(191)
  hearingId   String? @db.VarChar(191)
  caseId      String? @db.LongText
  type        String @db.LongText
  message     String @db.LongText
  sendAt      DateTime
  isSent      Boolean   @default(false)
  deliveryStatus String @default("QUEUED") @db.VarChar(191)
  providerMessageId String? @db.LongText
  lastError String? @db.LongText
  sentAt      DateTime?
  recipientId String? @db.LongText
  createdAt   DateTime  @default(now())

  hearing Hearing? @relation(fields: [hearingId], references: [id])
}

// ─────────────────────────────────────────────
// DOCUMENTS
// category: FIR | CHARGE_SHEET | PLAINT | WRITTEN_STATEMENT | VAKALATNAMA
//           AFFIDAVIT | EVIDENCE | COURT_ORDER | JUDGMENT | NOTICE
//           AGREEMENT | IDENTITY_DOCUMENT | PROPERTY_DOCUMENT | PHOTO | OTHER
// ─────────────────────────────────────────────

model Document {
  id          String    @id @default(cuid()) @db.VarChar(191)
  caseId      String? @db.VarChar(191)
  clientId    String? @db.VarChar(191)
  name        String @db.LongText
  fileName    String @db.LongText
  fileUrl     String @db.LongText
  fileSize    Int?
  mimeType    String? @db.LongText
  category    String    @default("OTHER") @db.VarChar(191)
  folder      String? @db.LongText
  description String? @db.LongText
  uploadedBy  String? @db.LongText
  version     Int       @default(1)
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case     Case?             @relation(fields: [caseId], references: [id])
  client   Client?           @relation(fields: [clientId], references: [id])
  versions DocumentVersion[]
}

model DocumentVersion {
  id         String   @id @default(cuid()) @db.VarChar(191)
  documentId String @db.VarChar(191)
  version    Int
  fileUrl    String @db.LongText
  uploadedBy String? @db.LongText
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
}

// ─────────────────────────────────────────────
// BILLING & PAYMENTS
// feeType: CONSULTATION|CASE_FEE|APPEARANCE|DRAFTING|FILING|
//          DOCUMENTATION|COURT_EXPENSES|TRAVEL|MISCELLANEOUS
// invoice status: PENDING | PARTIAL | PAID | OVERDUE | CANCELLED
// payment method: CASH | UPI | BANK_TRANSFER | CHEQUE | ONLINE
// ─────────────────────────────────────────────

model Invoice {
  id            String    @id @default(cuid()) @db.VarChar(191)
  invoiceNumber String    @unique @db.VarChar(191)
  clientId      String @db.VarChar(191)
  caseId        String? @db.VarChar(191)
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  totalAmount   Float
  paidAmount    Float     @default(0)
  pendingAmount Float
  gstAmount     Float     @default(0)
  creditAmount  Float     @default(0)
  status        String    @default("PENDING") @db.VarChar(191)
  notes         String? @db.LongText
  createdBy     String? @db.LongText
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client   Client        @relation(fields: [clientId], references: [id])
  case     Case?         @relation(fields: [caseId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
  paymentOrders PaymentOrder[]
}

model PaymentOrder {
  id String @id @db.VarChar(191)
  invoiceId String @db.VarChar(191)
  amount Int
  currency String @default("INR") @db.VarChar(191)
  status String @default("CREATED") @db.VarChar(191)
  paymentId String? @unique @db.VarChar(191)
  createdAt DateTime @default(now())
  invoice Invoice @relation(fields:[invoiceId],references:[id])
}

model InvoiceItem {
  id          String  @id @default(cuid()) @db.VarChar(191)
  invoiceId   String @db.VarChar(191)
  feeType     String @db.LongText
  description String @db.LongText
  quantity    Float   @default(1)
  rate        Float
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id            String    @id @default(cuid()) @db.VarChar(191)
  paymentId     String    @unique @db.VarChar(191)
  clientId      String @db.VarChar(191)
  invoiceId     String? @db.VarChar(191)
  amount        Float
  paymentDate   DateTime  @default(now())
  paymentMethod String @db.LongText
  transactionId String? @db.LongText
  receiptNumber String? @db.LongText
  notes         String? @db.LongText
  recordedBy    String? @db.LongText
  createdAt     DateTime  @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
}

// ─────────────────────────────────────────────
// APPOINTMENTS
// type: ONLINE | OFFLINE | PHONE
// status: PENDING | CONFIRMED | CANCELLED | COMPLETED
// ─────────────────────────────────────────────

model Appointment {
  id              String    @id @default(cuid()) @db.VarChar(191)
  clientId        String? @db.VarChar(191)
  name            String @db.LongText
  mobile          String @db.LongText
  email           String? @db.LongText
  advocateId      String? @db.LongText
  appointmentDate DateTime
  slot            String? @db.LongText
  type            String    @default("OFFLINE") @db.VarChar(191)
  purpose         String? @db.LongText
  status          String    @default("PENDING") @db.VarChar(191)
  fee             Float?
  paymentStatus   String? @db.LongText
  notes           String? @db.LongText
  meetLink        String? @db.LongText
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─────────────────────────────────────────────
// TASKS
// priority: LOW | NORMAL | HIGH | URGENT
// status: PENDING | IN_PROGRESS | COMPLETED | OVERDUE
// ─────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid()) @db.VarChar(191)
  title       String @db.LongText
  description String? @db.LongText
  caseId      String? @db.VarChar(191)
  assigneeId  String? @db.VarChar(191)
  creatorId   String? @db.VarChar(191)
  priority    String    @default("NORMAL") @db.VarChar(191)
  status      String    @default("PENDING") @db.VarChar(191)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case     Case? @relation(fields: [caseId], references: [id])
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User? @relation("TaskCreator", fields: [creatorId], references: [id])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// type: INFO | WARNING | SUCCESS | ERROR
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String @db.VarChar(191)
  title     String @db.LongText
  message   String @db.LongText
  type      String   @default("INFO") @db.VarChar(191)
  isRead    Boolean  @default(false)
  link      String? @db.LongText
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// COURT HOLIDAYS
// type: NATIONAL | STATE | COURT_SPECIFIC
// ─────────────────────────────────────────────

model CourtHoliday {
  id        String   @id @default(cuid()) @db.VarChar(191)
  date      DateTime
  name      String @db.LongText
  court     String? @db.LongText
  type      String   @default("NATIONAL") @db.VarChar(191)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// NEWS / LEGAL UPDATES
// category: NEWS | LEGAL_UPDATE | ANNOUNCEMENT
// ─────────────────────────────────────────────

model NewsUpdate {
  id          String   @id @default(cuid()) @db.VarChar(191)
  title       String @db.LongText
  content     String @db.LongText
  category    String? @db.LongText
  imageUrl    String? @db.LongText
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  authorId    String? @db.LongText
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// TESTIMONIALS
// ─────────────────────────────────────────────

model Testimonial {
  id          String   @id @default(cuid()) @db.VarChar(191)
  clientName  String @db.LongText
  designation String? @db.LongText
  content     String @db.LongText
  rating      Int      @default(5)
  imageUrl    String? @db.LongText
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FirmSetting {
  key String @id @db.VarChar(191)
  value String @db.LongText
  updatedAt DateTime @updatedAt
}

model Expense {
  id String @id @default(cuid()) @db.VarChar(191)
  description String @db.LongText
  category String @db.LongText
  amount Float
  date DateTime @default(now())
  caseId String? @db.LongText
  recordedBy String? @db.LongText
  createdAt DateTime @default(now())
}
