DATABASE_URL="file:./prisma/dev.db"
# Hostinger: after setting the real MySQL credentials, build selects the MySQL
# schema and applies committed migrations. URL-encode the database password.
# DATABASE_URL="mysql://USER:ENCODED_PASSWORD@127.0.0.1:3306/DATABASE"
DOCUMENT_ENCRYPTION_KEY="generate-a-64-character-random-hex-key"
# Set an absolute private persistent directory on the server, outside hbuilds/public_html.
DOCUMENT_STORAGE_DIR=""
# Optional shared-hosting CPU affinity limit (1–4). Hostinger runtime defaults to 2.
HOSTINGER_CPU_LIMIT=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NOTIFICATIONS_ENABLED="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_CONTENT_SID=""
# One complete origin, e.g. https://divinewall.in (not a list).
APP_ORIGIN=""
# Optional comma-separated complete HTTPS aliases, e.g. https://www.divinewall.in.
APP_ALLOWED_ORIGINS=""
TRUST_PROXY="false"
REQUIRE_PRIVILEGED_2FA="false"
# Optional separate 64-character hex key for authenticator secrets.
AUTH_ENCRYPTION_KEY=""
